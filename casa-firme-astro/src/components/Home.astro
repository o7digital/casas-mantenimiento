---
import "../styles/global.css";
import SeoHead from "./SeoHead.astro";
import english from "../i18n/en.json";
import projectGallery from "../data/project-gallery.json";

interface Props { lang: "es" | "en" }
const { lang } = Astro.props;
const t = (text: string) => lang === "en" ? (english as Record<string, string>)[text] ?? text : text;
const canonical = new URL(lang === "en" ? "/en/" : "/", Astro.site);


const navigation = [
  { href: "#quienes-somos", label: t("Quiénes somos") },
  { href: "#servicios", label: t("Nuestros Servicios") },
  { href: "#proyectos", label: t("Proyectos") },
  { href: "#cotizar", label: t("Contacto") },
];

const services = [
  { number: "01", icon: "⌁", title: t("Mantenimiento residencial"), text: t("Inspecciones, ajustes y reparaciones para conservar su hogar en óptimas condiciones."), value: t("Mantenimiento general"), featured: true },
  { number: "02", icon: "ϟ", title: t("Electricidad"), text: t("Instalaciones, contactos, iluminación y diagnóstico de fallas eléctricas."), value: t("Electricidad") },
  { number: "03", icon: "◒", title: t("Plomería"), text: t("Fugas, grifería, sanitarios, tuberías y soluciones preventivas."), value: t("Plomería") },
  { number: "04", icon: "◇", title: t("Pintura y acabados"), text: t("Renovación de interiores y exteriores con acabados limpios y duraderos."), value: t("Pintura y acabados") },
  { number: "05", icon: "⌂", title: t("Impermeabilización"), text: t("Revisión, prevención y tratamiento profesional contra humedad y filtraciones."), value: t("Impermeabilización") },
  { number: "06", icon: "▤", title: t("Oficinas y comercios"), text: t("Mantenimiento programado para espacios de trabajo siempre operativos."), value: t("Oficinas y comercios") },
];

const commitments = [
  ["01", t("Diagnóstico"), t("profesional")],
  ["02", t("Presupuesto"), t("transparente")],
  ["03", t("Seguimiento"), t("por WhatsApp")],
];

const aboutPrinciples = [
  {
    title: t("Entender antes de intervenir."),
    text: t("Una mancha de humedad puede ser el síntoma, no el origen. Nuestro criterio es revisar de dónde viene el problema y explicar qué necesita atención antes de proponer una reparación."),
    detail: t("Diagnóstico que orienta la decisión."),
  },
  {
    title: t("Acordar antes de ejecutar."),
    text: t("El alcance, los materiales, los tiempos y el costo deben quedar claros desde el inicio. Si aparece algo que cambia lo acordado, corresponde explicarlo y revisarlo con usted antes de avanzar."),
    detail: t("Decisiones con información, sin presión."),
  },
  {
    title: t("Cuidar mientras trabajamos."),
    text: t("Entrar a una propiedad exige respeto por quienes la usan. Proteger superficies, mantener las herramientas en orden y retirar los residuos son parte del trabajo, tanto como el acabado final."),
    detail: t("Respeto por su espacio y su rutina."),
  },
];

const planBenefits = [
  ["01", t("Revisión general programada"), t("Detectamos desgaste, fugas y riesgos antes de que crezcan.")],
  ["02", t("Prioridad de atención"), t("Respuesta preferente cuando necesite una intervención.")],
  ["03", t("Historial de mantenimiento"), t("Registro claro de servicios, hallazgos y recomendaciones.")],
];

const process = [
  ["1", t("Cotización sin compromiso"), t("Conocemos el inmueble, escuchamos sus necesidades y definimos el alcance.")],
  ["2", t("Contrato formal"), t("Acordamos por escrito costos, materiales, tiempos y la garantía del trabajo.")],
  ["3", t("Reportes de avance"), t("Documentamos cada etapa y mantenemos comunicación clara durante la ejecución.")],
  ["4", t("Entrega limpia"), t("Revisamos los acabados, retiramos residuos y entregamos el espacio listo para usarse.")],
];

const projectTypes = [
  ["01", t("Mantenimiento preventivo y correctivo"), t("Impermeabilización, plomería y sistemas eléctricos para evitar fallas y recuperar la operación de cada espacio.")],
  ["02", t("Remodelaciones integrales"), t("Modernización coordinada de cocinas, baños, fachadas y locales comerciales, del diagnóstico a los acabados.")],
  ["03", t("Conservación de inmuebles"), t("Pintura general, resanes y restauración de áreas comunes para prolongar la vida y el valor de la propiedad.")],
];

const portfolioStories = [
  {
    number: "01",
    eyebrow: t("Antes y después"),
    title: t("De un espacio deteriorado a un ambiente renovado."),
    text: t("La misma perspectiva permite comprobar la transformación: control de humedad, renovación de instalaciones y acabados limpios."),
    image: "/proyecto-antes-despues.webp",
    alt: t("Comparación antes y después de una remodelación de baño con humedad corregida y nuevos acabados"),
    width: 1600,
    height: 1067,
  },
  {
    number: "02",
    eyebrow: t("Zoom a los detalles"),
    title: t("La calidad se reconoce de cerca."),
    text: t("Instalaciones ordenadas, cortes precisos, pintura uniforme, carpintería cuidada y pisos correctamente alineados."),
    image: "/detalles-acabados.webp",
    alt: t("Detalles de instalación de plomería, encuentro de pintura con carpintería y colocación precisa de piso"),
    width: 1600,
    height: 901,
  },
];

const proofSteps = [
  ["01", t("Estado inicial"), t("Registramos las condiciones del inmueble antes de intervenir, con diagnóstico y evidencia fotográfica."), "estado-inicial", [[t("Inspección visual"), t("Revisamos superficies, instalaciones y puntos críticos del inmueble.")], [t("Registro fotográfico"), t("Creamos evidencia clara del estado previo a cualquier trabajo.")], [t("Alcance definido"), t("Acordamos prioridades, materiales, tiempos y costos antes de comenzar.")]]],
  ["02", t("Avance por etapas"), t("Documentamos lo ejecutado, los siguientes trabajos y cualquier decisión necesaria durante la obra."), "avance-etapas", [[t("Plan de trabajo"), t("Ordenamos actividades, especialidades, accesos y tiempos de secado.")], [t("Reportes de avance"), t("Compartimos fotografías, logros y las siguientes acciones programadas.")], [t("Control de cambios"), t("Explicamos y autorizamos cualquier imprevisto antes de continuar.")]]],
  ["03", t("Detalle de acabados"), t("Revisamos juntas, cortes, pintura, instalaciones y cada detalle que determina la calidad final."), "detalle-acabados", [[t("Revisión técnica"), t("Verificamos niveles, sellos, conexiones y funcionamiento.")], [t("Control de acabados"), t("Inspeccionamos juntas, cortes, pintura y encuentros visibles.")], [t("Lista de pendientes"), t("Registramos y resolvemos cada corrección antes de la aceptación final.")]]],
  ["04", t("Entrega limpia"), t("Retiramos protecciones, herramientas y residuos, y entregamos el espacio listo para usarse."), "entrega-limpia", [[t("Limpieza final"), t("Retiramos protecciones, herramientas y residuos de la obra.")], [t("Expediente de entrega"), t("Reunimos fotografías, materiales utilizados y recomendaciones de cuidado.")], [t("Garantía y seguimiento"), t("Formalizamos el respaldo acordado y damos seguimiento posterior.")]]],
];

const projectCases = [
  {
    number: "01",
    type: t("Mantenimiento correctivo"),
    title: t("Control de humedad e impermeabilización"),
    challenge: t("Filtraciones recurrentes, manchas interiores y desprendimiento de pintura durante la temporada de lluvias."),
    solution: t("Inspección de pendientes y puntos críticos, resane, sellado de fisuras y aplicación del sistema impermeable compatible con la superficie."),
    materials: t("Sellador, malla de refuerzo y sistema impermeabilizante especificados tras el diagnóstico."),
    timing: t("Cronograma definido después de medir el área y revisar las condiciones climáticas."),
    warranty: t("Respaldo por escrito; la ficha contractual indica los meses o años según el sistema y fabricante elegidos."),
  },
  {
    number: "02",
    type: t("Remodelación integral"),
    title: t("Modernización de baño residencial"),
    challenge: t("Instalaciones antiguas, distribución poco funcional y acabados afectados por humedad persistente."),
    solution: t("Corrección de instalaciones, impermeabilización de zonas húmedas, colocación de recubrimientos y renovación de mobiliario y accesorios."),
    materials: t("Tubería, adhesivos, boquilla, recubrimientos y selladores definidos en la propuesta aprobada."),
    timing: t("Programa por etapas para coordinar demoliciones, instalaciones, secados y acabados."),
    warranty: t("Garantía de mano de obra y materiales formalizada en contrato con vigencia claramente indicada."),
  },
  {
    number: "03",
    type: t("Conservación de inmuebles"),
    title: t("Recuperación de fachada y áreas comunes"),
    challenge: t("Fisuras, pintura degradada y una imagen exterior que ya no correspondía con el valor del inmueble."),
    solution: t("Preparación de superficies, resanes localizados, sellado, pintura y restauración ordenada de elementos visibles."),
    materials: t("Resanadores, selladores y recubrimientos seleccionados según exposición, sustrato y acabado requerido."),
    timing: t("Plan de trabajo acordado para mantener accesos seguros y reducir afectaciones a los usuarios."),
    warranty: t("Periodo de respaldo expresado en meses o años dentro de la cotización y el contrato de obra."),
  },
];

const messages = Object.fromEntries(["Abrir menú", "Cerrar menú", "Enviar solicitud", "Enviando…", "Hay demasiados intentos de envío. Espere unos minutos y vuelva a intentarlo. Sus datos siguen aquí.", "No se pudo enviar la solicitud. Revise los datos e inténtelo de nuevo en unos minutos. Sus datos siguen aquí.", "No pudimos confirmar el envío. Sus datos siguen aquí; revise su conexión e inténtelo de nuevo.", "Revise el correo electrónico: incluya un formato válido, por ejemplo, nombre@gmail.com.", "El correo electrónico es obligatorio."].map(key => [key, t(key)]));
---

<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead
      lang={lang}
      title={t("Espacio Firme | Mantenimiento residencial en México, CDMX")}
      description={t("Mantenimiento profesional, preventivo y correctivo para casas y oficinas en México, CDMX.")}
      pathname={lang === "en" ? "/en/" : "/"}
      alternatePathname={lang === "en" ? "/" : "/en/"}
      includeOrganization
    />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-D4WRBHJYXW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-D4WRBHJYXW');
    </script>
  </head>
  <body data-messages={JSON.stringify(messages)}>
    <header class="site-header" id="inicio">
      <a class="brand" href="#inicio" aria-label={t("Espacio Firme, inicio")}>
        <span class="brand-mark" aria-hidden="true">EF</span>
        <span><strong>ESPACIO FIRME</strong><small>{t("Mantenimiento integral")}</small></span>
      </a>
      <nav class="desktop-nav" aria-label={t("Navegación principal")}>
        {navigation.map(({ href, label }) => <a href={href}>{label}</a>)}
      </nav>
      <div class="header-actions">
        <nav class="language-switch" aria-label={t("Idioma")}>
          <a href="/" lang="es" hreflang="es" aria-label="Español" aria-current={lang === "es" ? "page" : undefined}>ES</a>
          <a href="/en/" lang="en" hreflang="en" aria-label="English" aria-current={lang === "en" ? "page" : undefined}>EN</a>
        </nav>
        <a class="header-cta" href="#cotizar">{t("Solicitar visita")} <span>↗</span></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={t("Abrir menú")}>
          <span></span><span></span><span></span>
        </button>
      </div>
      <nav class="mobile-menu" id="mobile-menu" aria-label={t("Navegación móvil")} hidden>
        {navigation.map(({ href, label }, index) => <a href={href}><span>0{index + 1}</span>{label}</a>)}
        <a class="button button-primary" href="#cotizar">{t("Solicitar visita")} <span>→</span></a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-image" role="img" aria-label={t("Casa contemporánea con servicio profesional de mantenimiento")}></div>
        <div class="hero-shade"></div>
        <div class="hero-content">
          <p class="eyebrow"><span></span> {t("Mantenimiento residencial y corporativo")}</p>
          <h1 id="hero-title">{t("Su propiedad,")}<br /><em>{t("siempre en orden.")}</em></h1>
          <p class="hero-copy">{t("Cuidamos cada detalle de su casa u oficina con atención profesional, seguimiento claro y soluciones que duran.")}</p>
          <div class="hero-actions"><a class="button button-primary" href="#cotizar">{t("Agendar una visita")} <span>→</span></a><a class="button button-ghost" href="#servicios">{t("Conocer servicios")}</a></div>
        </div>
        <aside class="trust-panel" aria-label={t("Compromisos de servicio")}>
          {commitments.map(([number, first, second]) => <div><strong>{number}</strong><span>{first}<br />{second}</span></div>)}
        </aside>
      </section>

      <section class="about section-pad" id="quienes-somos" aria-labelledby="about-title">
        <div class="about-intro">
          <div class="about-copy">
            <p class="section-label">{t("Quiénes somos · Espacio Firme")}</p>
            <h2 id="about-title">{t("Cuidamos su inmueble.")}<br /><em>{t("Protegemos su inversión.")}</em></h2>
            <p class="about-lead">{t("En Espacio Firme somos una empresa de mantenimiento e ingeniería inmobiliaria dedicada a la preservación y optimización de activos.")}</p>
            <p>{t("Guiados por la honestidad, el compromiso absoluto y una rigurosa atención al detalle, diseñamos soluciones a la medida para los sectores residencial, corporativo y comercial.")}</p>
            <p>{t("Nuestro propósito es garantizar que cada espacio opere a su máxima capacidad y bajo los más altos estándares de seguridad, asegurando la rentabilidad de su inversión a largo plazo.")}</p>
            <div class="about-system" aria-label={t("Nuestro ciclo de gestión inmobiliaria")}>
              <div class="about-system-heading">
                <p class="section-label">{t("Ciclo de valor del inmueble")}</p>
                <p>{t("Un solo equipo, de la prevención a la transformación.")}</p>
              </div>
              <ol class="about-system-flow">
                {[t("Diagnosticamos"), t("Planificamos"), t("Ejecutamos"), t("Verificamos")].map((step, index) => (
                  <li><span>0{index + 1}</span><strong>{step}</strong></li>
                ))}
              </ol>
              <div class="about-system-outcomes">
                <div><span aria-hidden="true">＋</span><p>{t("Seguridad")}</p></div>
                <div><span aria-hidden="true">↻</span><p>{t("Continuidad")}</p></div>
                <div><span aria-hidden="true">↗</span><p>{t("Valor a largo plazo")}</p></div>
              </div>
            </div>
          </div>
          <aside class="about-note" aria-label={t("Misión y visión de Espacio Firme")}>
            <span class="about-monogram" aria-hidden="true">EF</span>
            <div class="about-statement">
              <p class="section-label">{t("Misión")}</p>
              <h3>{t("Garantizar la máxima vida útil, seguridad y rentabilidad de cada activo inmobiliario.")}</h3>
              <p>{t("Lo logramos mediante una gestión integral basada en el rigor del Project Management, la honestidad, el compromiso absoluto y una minuciosa atención al detalle.")}</p>
            </div>
            <div class="about-statement about-vision">
              <p class="section-label">{t("Visión")}</p>
              <h3>{t("Ser la empresa referente en mantenimiento e ingeniería inmobiliaria.")}</h3>
              <p>{t("Aspiramos a ser un aliado de confianza, reconocido por nuestra atención al detalle, transparencia operativa y capacidad de adaptación a cada necesidad.")}</p>
            </div>
            <div class="about-note-signature">Espacio Firme <span>{t("Mantenimiento integral")}</span></div>
          </aside>
        </div>

        <div class="about-principles" aria-labelledby="about-principles-title">
          <div class="about-principles-heading">
            <p class="section-label">{t("Lo que guía nuestro trabajo")}</p>
            <h3 id="about-principles-title">{t("La confianza se construye en los detalles.")}</h3>
          </div>
          <div class="about-principles-grid">
            {aboutPrinciples.map(({ title, text, detail }, index) => (
              <article>
                <span class="about-number" aria-hidden="true">0{index + 1}</span>
                <h4>{title}</h4>
                <p>{text}</p>
                <p class="about-principle-detail">{detail}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="about-next">
          <p>{t("Empiece por contarnos qué le preocupa de su propiedad.")}</p>
          <a class="button button-dark" href="#cotizar">{t("Conversemos sobre su espacio")} <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="portfolio section-pad" id="portafolio" aria-labelledby="portfolio-title">
        <div class="section-heading"><div><p class="section-label">{t("Portafolio visual")}</p><h2 id="portfolio-title">{t("El cuidado se ve")}<br />{t("en cada detalle.")}</h2></div><p>{t("Transformaciones reales, acabados pulcros y equipos que trabajan con seguridad, orden y respeto por su propiedad.")}</p></div>
        <div class="portfolio-gallery">
          {portfolioStories.map((story) => (
            <article class="portfolio-story">
              <img src={story.image} alt={story.alt} loading="lazy" width={story.width} height={story.height} />
              <div class="portfolio-story-copy"><span>{story.number}</span><div><p>{story.eyebrow}</p><h3>{story.title}</h3><div class="story-description">{story.text}</div></div></div>
            </article>
          ))}
        </div>
        <div class="portfolio-proof" aria-label={t("Qué documentamos en cada proyecto")}>
          <p>{t("Una obra bien hecha también debe poder comprobarse.")}</p>
          <ol>
            {proofSteps.map(([number, title, description], index) => (
              <li>
                <button class="portfolio-proof-trigger" type="button" aria-expanded={index === 0 ? "true" : "false"} aria-controls={`proof-detail-${index}`} data-proof-index={index}>
                  <span class="portfolio-proof-number" aria-hidden="true">{number}</span>
                  <strong>{title}</strong>
                  <p>{description}</p>
                  <span class="portfolio-proof-link">{t("Ver detalle")} <span aria-hidden="true">↓</span></span>
                </button>
              </li>
            ))}
          </ol>
          <div class="portfolio-proof-details">
            {proofSteps.map(([number, title, description, anchor, details], index) => (
              <article id={`proof-detail-${index}`} data-proof-detail={index} hidden={index !== 0}>
                <header><span>{number}</span><div><p>{t("Evidencia de la etapa")}</p><h3>{title}</h3></div></header>
                <p class="portfolio-proof-summary">{description}</p>
                <div class="portfolio-proof-detail-grid">
                  {(details as string[][]).map(([detailTitle, detailText]) => <div><strong>{detailTitle}</strong><p>{detailText}</p></div>)}
                </div>
                <a class="text-link" href={`${lang === "en" ? "/en/process/" : "/proceso/"}#${anchor}`}>{t("Conocer el proceso completo")} <span>→</span></a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="projects section-pad" id="proyectos" aria-labelledby="projects-title">
        <div class="section-heading light"><div><p class="section-label">{t("Experiencia técnica")}</p><h2 id="projects-title">{t("Soluciones para cada etapa del inmueble.")}</h2></div><p>{t("Atendemos desde una corrección puntual hasta una remodelación completa, siempre con alcance, tiempos y respaldo claros.")}</p></div>
        <div class="project-galleries">
          {projectGallery.map((group) => (
            <section class="project-gallery" aria-labelledby={`gallery-${group.id}`}>
              <div class="project-gallery-heading">
                <div><p class="section-label">{t("Proyectos realizados")}</p><h3 id={`gallery-${group.id}`}>{t(group.title)}</h3></div>
                <p>{t(group.description)}</p>
              </div>
              <div class="project-photo-grid">
                {group.photos.map((photo, index) => (
                  <figure class="project-photo">
                    <a class="project-photo-link" href={photo.src} data-caption={t(photo.alt)} aria-label={`${t("Ampliar foto")}: ${t(photo.alt)}`}>
                      <img src={photo.src} srcset={`${photo.thumbnail} ${photo.thumbnailWidth}w, ${photo.src} ${photo.width}w`} sizes="(max-width: 760px) 100vw, (max-width: 1050px) 50vw, 33vw" alt={t(photo.alt)} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
                      <span class="project-photo-enlarge" aria-hidden="true">↗</span>
                    </a>
                    <figcaption><span>{String(index + 1).padStart(2, "0")}</span>{t(photo.alt)}</figcaption>
                  </figure>
                ))}
              </div>
              {group.portraitPhotos && (
                <div class="project-portraits">
                  <div class="project-portraits-heading">
                    <h4 id={`portraits-${group.id}`}>{t("Interiores y accesos")}</h4>
                    <div class="portrait-controls">
                      <button type="button" data-direction="-1" aria-label={t("Ver fotos anteriores")} aria-controls={`portrait-row-${group.id}`}>←</button>
                      <button type="button" data-direction="1" aria-label={t("Ver más fotos")} aria-controls={`portrait-row-${group.id}`}>→</button>
                    </div>
                  </div>
                  <div class="project-portrait-row" id={`portrait-row-${group.id}`} role="region" aria-labelledby={`portraits-${group.id}`} tabindex="0">
                    {group.portraitPhotos.map((photo, index) => (
                      <figure class="project-photo">
                        <a class="project-photo-link" href={photo.src} data-caption={t(photo.alt)} aria-label={`${t("Ampliar foto")}: ${t(photo.alt)}`}>
                          <img src={photo.src} srcset={`${photo.thumbnail} ${photo.thumbnailWidth}w, ${photo.src} ${photo.width}w`} sizes="(max-width: 760px) 80vw, (max-width: 1050px) 33vw, 25vw" alt={t(photo.alt)} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
                          <span class="project-photo-enlarge" aria-hidden="true">↗</span>
                        </a>
                        <figcaption><span>{String(group.photos.length + index + 1).padStart(2, "0")}</span>{t(photo.alt)}</figcaption>
                      </figure>
                    ))}
                  </div>
                </div>
              )}
            </section>
          ))}
        </div>
        <div class="project-types">{projectTypes.map(([number, title, copy]) => <article><span>{number}</span><h3>{title}</h3><p>{copy}</p></article>)}</div>
        <div class="case-heading-main"><p class="section-label">{t("Proyectos realizados · fichas técnicas")}</p><h3>{t("Del reto inicial al respaldo final.")}</h3><p>{t("Cada expediente reúne el diagnóstico, la solución, los materiales, el tiempo de ejecución y la garantía acordada.")}</p></div>
        <div class="case-grid">
          {projectCases.map((project) => (
            <article class="case-card">
              <header><span>{project.number}</span><p>{project.type}</p><h3>{project.title}</h3></header>
              <dl>
                <div><dt>{t("Reto inicial")}</dt><dd>{project.challenge}</dd></div>
                <div><dt>{t("Solución aplicada")}</dt><dd>{project.solution}</dd></div>
                <div><dt>{t("Materiales")}</dt><dd>{project.materials}</dd></div>
                <div><dt>{t("Tiempo de ejecución")}</dt><dd>{project.timing}</dd></div>
                <div><dt>{t("Garantía")}</dt><dd>{project.warranty}</dd></div>
              </dl>
            </article>
          ))}
        </div>
      </section>

      <section class="services section-pad" id="servicios" aria-labelledby="services-title">
        <div class="section-heading services-heading">
          <div><p class="section-label">{t("Nuestros Servicios")}</p><h2 id="services-title">{t("Gestión, Mantenimiento y Conservación del Activo Inmobiliario")}</h2></div>
          <p class="services-tagline"><strong><em>{t("Maximice la vida útil, rentabilidad y seguridad de su infraestructura con rigor de Project Management.")}</em></strong></p>
        </div>
        <div class="services-intro">
          <p>{t("En el sector corporativo, industrial y comercial, un inmueble no es solo un espacio; es un activo crítico que impacta directamente en la continuidad del negocio y la rentabilidad.")}</p>
          <div>
            <p>{t("Nuestro equipo integra experiencia en ingeniería, arquitectura y Project Management para ofrecer un servicio integral de")} <strong>{t("Mantenimiento y Conservación de Inmuebles")}</strong>.</p>
            <p>{t("Nuestro enfoque combina precisión técnica con una rigurosa gestión de costes y plazos, garantizando que su infraestructura opere siempre al máximo de su capacidad.")}</p>
          </div>
        </div>
        <div class="service-grid">
          {services.map((service) => (
            <article class:list={["service-card", { "service-featured": service.featured }]}>
              <div class="service-top"><span class="service-number">{service.number}</span><span class="service-icon" aria-hidden="true">{service.icon}</span></div>
              <div><h3>{service.title}</h3><p>{service.text}</p></div>
              <a class="text-link service-select" href="#cotizar" data-service={service.value}>{t("Solicitar servicio")} <span>→</span></a>
            </article>
          ))}
        </div>
      </section>

      <section class="plan section-pad" id="planes" aria-labelledby="plan-title">
        <div class="plan-visual"><div class="plan-image" role="img" aria-label={t("Detalle arquitectónico de una casa bien cuidada")}></div><div class="plan-badge"><strong>12</strong><span>{t("meses de")}<br />{t("tranquilidad")}</span></div></div>
        <div class="plan-content">
          <p class="section-label">{t("Plan Espacio Firme")}</p><h2 id="plan-title">{t("Prevenir cuesta menos que reparar.")}</h2>
          <p class="plan-intro">{t("Un programa anual diseñado para anticiparse a los problemas y proteger el valor de su propiedad.")}</p>
          <ul class="plan-list">{planBenefits.map(([number, title, copy]) => <li><span>{number}</span><div><strong>{title}</strong><p>{copy}</p></div></li>)}</ul>
          <a class="button button-dark service-select" href="#cotizar" data-service={t("Plan anual")}>{t("Conocer el plan anual")} <span>→</span></a>
        </div>
      </section>

      <section class="process section-pad" id="proceso" aria-labelledby="process-title">
        <div class="section-heading light"><div><p class="section-label">{t("Así de fácil")}</p><h2 id="process-title">{t("Cuidamos su espacio")}<br />{t("de principio a fin.")}</h2></div></div>
        <div class="process-grid">{process.map(([number, title, copy]) => <article><span>{number}</span><h3>{title}</h3><p>{copy}</p></article>)}</div>
      </section>

      <section class="community section-pad" id="comunidad" aria-labelledby="community-title">
        <div><p class="section-label">{t("Comunidad digital")}</p><h2 id="community-title">{t("Vea cómo cuidamos cada obra, día a día.")}</h2></div>
        <div><p>{t("En Instagram compartimos avances, transformaciones y consejos prácticos para conservar mejor su inmueble.")}</p><a class="button button-dark" href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" aria-label={t("Visitar Instagram, abre en una nueva pestaña")}>{t("Visitar Instagram")} <span>↗</span></a></div>
      </section>

      <section class="quote section-pad" id="cotizar" aria-labelledby="quote-title">
        <div class="quote-intro"><p class="section-label">{t("Contacto")}</p><h2 id="quote-title">{t("Hablemos de su propiedad.")}</h2><p>{t("Déjenos sus datos para preparar una cotización sin compromiso y atenderle de forma ágil.")}</p><p>{t("Incluya su correo para que podamos responderle. Si prefiere que le contactemos por teléfono o WhatsApp, deje también su número e indíquelo en el mensaje.")}</p><div class="availability"><i></i><span>{t("Atención en casas, oficinas y comercios")}</span></div></div>
        <form class="quote-form" id="quote-form" action="https://formspree.io/f/moeqrljv" method="POST" aria-describedby="form-note">
          <input type="hidden" name="language" value={lang} />
          <input type="hidden" name="_subject" value={t("Nueva solicitud de contacto — Espacio Firme")} />
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" hidden />
          <label>{t("Nombre completo")}<input id="name" name="name" type="text" autocomplete="name" placeholder={t("¿Cómo podemos llamarle?")} required /></label>
          <label>{t("Correo electrónico")}<input id="email" name="email" type="email" autocomplete="email" placeholder={t("usted@ejemplo.com")} aria-describedby="email-error" required /><span class="field-error" id="email-error" role="alert" hidden></span></label>
          <label>{t("Teléfono o WhatsApp (opcional)")}<input id="phone" name="phone" type="tel" autocomplete="tel" placeholder={t("Incluya el código de país")} /></label>
          <div class="field-row">
            <label>{t("Tipo de propiedad")}<select id="property" name="property"><option>{t("Casa habitación")}</option><option>{t("Departamento")}</option><option>{t("Oficina")}</option><option>{t("Comercio")}</option></select></label>
            <label>{t("Servicio")}<select id="service" name="service"><option>{t("Mantenimiento general")}</option><option>{t("Electricidad")}</option><option>{t("Plomería")}</option><option>{t("Pintura y acabados")}</option><option>{t("Impermeabilización")}</option><option>{t("Oficinas y comercios")}</option><option>{t("Plan anual")}</option></select></label>
          </div>
          <label>{t("¿Qué necesita resolver?")}<textarea id="details" name="details" rows="3" placeholder={t("Cuéntenos brevemente...")}></textarea></label>
          <button class="button button-primary form-submit" type="submit"><span id="submit-label">{t("Enviar solicitud")}</span><span aria-hidden="true">→</span></button>
          <p class="form-note" id="form-note">{t("Sin compromiso. Usaremos sus datos para responder a su solicitud.")}</p>
          <div class="form-success" id="form-success" role="status" aria-live="polite" hidden><strong>{t("Solicitud enviada.")}</strong><span>{t("Gracias por escribirnos. Nos pondremos en contacto con usted para revisar los detalles.")}</span></div>
          <p class="form-error" id="form-error" role="alert" hidden></p>
        </form>
      </section>
    </main>

    <dialog class="photo-viewer" aria-label={t("Galería de proyectos")}>
      <div class="photo-viewer-toolbar"><p class="photo-viewer-count" aria-live="polite"></p><button class="photo-viewer-close" type="button" autofocus>{t("Cerrar foto")} <span aria-hidden="true">×</span></button></div>
      <img class="photo-viewer-image" alt="" />
      <div class="photo-viewer-footer"><button class="photo-viewer-prev" type="button" aria-label={t("Foto anterior")}>←</button><p class="photo-viewer-caption" aria-live="polite"></p><button class="photo-viewer-next" type="button" aria-label={t("Foto siguiente")}>→</button></div>
    </dialog>

    <footer><a class="brand footer-brand" href="#inicio"><span class="brand-mark">EF</span><span><strong>ESPACIO FIRME</strong><small>{t("Mantenimiento integral")}</small></span></a><p>{t("Su propiedad en buenas manos.")}</p><div class="footer-meta"><a href={lang === "en" ? "/en/privacy-policy/" : "/aviso-de-privacidad/"}>{t("Aviso de privacidad")}</a><p class="copyright">© <span id="year"></span> Espacio Firme</p></div></footer>

    <script is:inline>
      // Restore only a position explicitly saved by the language switch.
      // Running after the markup avoids an animated trip through the page.
      try {
        const key = 'espacio-firme-language-position';
        const saved = JSON.parse(sessionStorage.getItem(key) || 'null');
        if (saved && saved.path === location.pathname) {
          sessionStorage.removeItem(key);
          if (Date.now() - saved.time < 30000) {
            const restore = () => {
              const section = document.querySelectorAll('header.site-header, main > section, footer')[saved.section];
              if (section) {
                window.scrollTo({
                  top: section.getBoundingClientRect().top + window.scrollY + Math.min(saved.offset, section.offsetHeight - 1),
                  behavior: 'instant',
                });
              }
            };
            restore();
            window.addEventListener('load', restore, { once: true });
          }
        }
      } catch {
        // Normal links remain usable when browser storage is unavailable.
      }
    </script>

    <script>
      document.querySelectorAll<HTMLElement>('.project-portraits').forEach(gallery => {
        const row = gallery.querySelector<HTMLElement>('.project-portrait-row')!;
        const previous = gallery.querySelector<HTMLButtonElement>('[data-direction="-1"]')!;
        const next = gallery.querySelector<HTMLButtonElement>('[data-direction="1"]')!;
        const updateControls = () => {
          previous.disabled = row.scrollLeft <= 1;
          next.disabled = row.scrollLeft + row.clientWidth >= row.scrollWidth - 1;
        };
        [previous, next].forEach(button => button.addEventListener('click', () => {
          row.scrollBy({ left: Number(button.dataset.direction) * row.clientWidth, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
        }));
        row.addEventListener('scroll', updateControls, { passive: true });
        new ResizeObserver(updateControls).observe(row);
        updateControls();
      });

      const photoViewer = document.querySelector<HTMLDialogElement>('.photo-viewer')!;
      const photoLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.project-photo-link'));
      const viewerImage = photoViewer.querySelector<HTMLImageElement>('.photo-viewer-image')!;
      const viewerCaption = photoViewer.querySelector<HTMLElement>('.photo-viewer-caption')!;
      const viewerCount = photoViewer.querySelector<HTMLElement>('.photo-viewer-count')!;
      let activePhoto = 0;
      const showPhoto = (index: number) => {
        activePhoto = (index + photoLinks.length) % photoLinks.length;
        const link = photoLinks[activePhoto];
        viewerImage.src = link.href;
        viewerImage.alt = link.dataset.caption ?? '';
        viewerCaption.textContent = viewerImage.alt;
        viewerCount.textContent = `${activePhoto + 1} / ${photoLinks.length}`;
      };
      photoLinks.forEach((link, index) => link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        showPhoto(index);
        photoViewer.showModal();
        document.documentElement.classList.add('photo-viewer-open');
      }));
      photoViewer.querySelector('.photo-viewer-close')!.addEventListener('click', () => photoViewer.close());
      photoViewer.querySelector('.photo-viewer-prev')!.addEventListener('click', () => showPhoto(activePhoto - 1));
      photoViewer.querySelector('.photo-viewer-next')!.addEventListener('click', () => showPhoto(activePhoto + 1));
      photoViewer.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          showPhoto(activePhoto + (event.key === 'ArrowRight' ? 1 : -1));
        }
      });
      photoViewer.addEventListener('click', (event) => {
        if (event.target === photoViewer) photoViewer.close();
      });
      photoViewer.addEventListener('close', () => document.documentElement.classList.remove('photo-viewer-open'));

      const messages: Record<string, string> = JSON.parse(document.body.dataset.messages!);
      const t = (text: string) => messages[text] ?? text;
      document.querySelectorAll<HTMLAnchorElement>('.language-switch a').forEach(link => {
        link.addEventListener('click', (event) => {
          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const destination = new URL(link.href);
          if (destination.pathname === window.location.pathname) {
            event.preventDefault();
            return;
          }

          const sections = Array.from(document.querySelectorAll<HTMLElement>('header.site-header, main > section, footer'));
          let sectionIndex = 0;
          sections.forEach((section, index) => {
            if (section.getBoundingClientRect().top <= 1) sectionIndex = index;
          });
          const section = sections[sectionIndex];
          const offset = Math.max(0, -section.getBoundingClientRect().top);

          // The current scroll position is authoritative; the URL hash may be stale.
          destination.hash = '';
          try {
            sessionStorage.setItem('espacio-firme-language-position', JSON.stringify({
              path: destination.pathname,
              section: sectionIndex,
              offset,
              time: Date.now(),
            }));
          } catch {
            // Fall back to the visible section, never to an old contact anchor.
            destination.hash = section.id;
          }
          event.preventDefault();
          window.location.assign(destination.href);
        });
      });

      const menuToggle = document.querySelector('.menu-toggle');
      const mobileMenu = document.querySelector('#mobile-menu');
      const proofTriggers = document.querySelectorAll('[data-proof-index]');
      const proofDetails = document.querySelectorAll('[data-proof-detail]');

      proofTriggers.forEach((trigger) => trigger.addEventListener('click', () => {
        const selected = trigger.getAttribute('data-proof-index');
        proofTriggers.forEach((item) => item.setAttribute('aria-expanded', String(item === trigger)));
        proofDetails.forEach((detail) => detail.toggleAttribute('hidden', detail.getAttribute('data-proof-detail') !== selected));
        if (window.matchMedia('(max-width: 760px)').matches) {
          document.querySelector(`[data-proof-detail="${selected}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }));

      const closeMenu = () => {
        mobileMenu.hidden = true;
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', t("Abrir menú"));
        document.body.classList.remove('menu-open');
      };
      menuToggle.addEventListener('click', () => {
        const willOpen = mobileMenu.hidden;
        mobileMenu.hidden = !willOpen;
        menuToggle.setAttribute('aria-expanded', String(willOpen));
        menuToggle.setAttribute('aria-label', willOpen ? t("Cerrar menú") : t("Abrir menú"));
        document.body.classList.toggle('menu-open', willOpen);
      });
      mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      window.addEventListener('resize', () => {
        if (window.innerWidth > 1200) closeMenu();
      });

      const serviceSelect = document.querySelector<HTMLSelectElement>('#service')!;
      const quoteSection = document.querySelector('#cotizar');
      document.querySelectorAll<HTMLAnchorElement>('.service-select').forEach((link) => {
        link.addEventListener('click', () => {
          serviceSelect.value = link.dataset.service!;
          quoteSection.scrollIntoView({ behavior: 'smooth' });
          window.setTimeout(() => document.querySelector('#name').focus(), 550);
        });
      });
      const quoteForm = document.querySelector<HTMLFormElement>('#quote-form')!;
      const submitButton = quoteForm.querySelector<HTMLButtonElement>('.form-submit')!;
      const submitLabel = document.querySelector('#submit-label')!;
      const success = document.querySelector<HTMLElement>('#form-success')!;
      const formError = document.querySelector<HTMLElement>('#form-error')!;
      const emailInput = document.querySelector<HTMLInputElement>('#email')!;
      const emailError = document.querySelector<HTMLElement>('#email-error')!;

      const validateEmail = () => {
        const value = emailInput.value.trim();
        const isValid = value === '' || /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value);
        const message = value === '' ? t("El correo electrónico es obligatorio.") : t("Revise el correo electrónico: incluya un formato válido, por ejemplo, nombre@gmail.com.");
        emailInput.setCustomValidity(isValid ? '' : message);
        emailError.textContent = isValid ? '' : message;
        emailError.hidden = isValid;
        emailInput.setAttribute('aria-invalid', String(!isValid));
        return isValid;
      };

      emailInput.addEventListener('input', validateEmail);
      emailInput.addEventListener('blur', validateEmail);

      quoteForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        validateEmail();
        if (submitButton.disabled || !quoteForm.reportValidity()) return;

        const data = new FormData(quoteForm);
        success.hidden = true;
        formError.hidden = true;
        submitButton.disabled = true;
        submitLabel.textContent = t("Enviando…");
        quoteForm.setAttribute('aria-busy', 'true');

        try {
          const response = await fetch(quoteForm.action, {
            method: 'POST',
            body: data,
            headers: { Accept: 'application/json' },
            signal: AbortSignal.timeout(20000),
          });

          if (!response.ok) {
            formError.textContent = response.status === 429
              ? t("Hay demasiados intentos de envío. Espere unos minutos y vuelva a intentarlo. Sus datos siguen aquí.")
              : t("No se pudo enviar la solicitud. Revise los datos e inténtelo de nuevo en unos minutos. Sus datos siguen aquí.");
            formError.hidden = false;
            return;
          }

          quoteForm.reset();
          success.hidden = false;
          success.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } catch {
          formError.textContent = t("No pudimos confirmar el envío. Sus datos siguen aquí; revise su conexión e inténtelo de nuevo.");
          formError.hidden = false;
        } finally {
          submitButton.disabled = false;
          submitLabel.textContent = t("Enviar solicitud");
          quoteForm.removeAttribute('aria-busy');
        }
      });
      document.querySelector('#year').textContent = new Date().getFullYear();
    </script>
  </body>
</html>
